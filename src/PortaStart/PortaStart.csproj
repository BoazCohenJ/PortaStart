<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10 and 11 install, so the .exe runs with nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PortaStart</RootNamespace>
    <AssemblyName>PortaStart</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.2</Version>
    <Product>PortaStart</Product>
    <Description>Start menu shortcuts for portable apps installed with winget.</Description>
    <Copyright>Copyright (c) 2026 BoazCohenJ</Copyright>
    <Company>PortaStart</Company>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PortaStart.Tests" />
  </ItemGroup>

</Project>
